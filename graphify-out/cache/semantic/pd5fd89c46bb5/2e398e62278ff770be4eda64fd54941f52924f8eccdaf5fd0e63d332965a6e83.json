ktree Provenance Cleanup Rule", "file_type": "rationale", "source_file": ".agents/skills/finishing-a-development-branch/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only worktrees under .worktrees/, worktrees/ or ~/.config/superpowers/worktrees/ are owned by the skill; harness-created workspaces must be left alone to avoid phantom state, and removal always runs from the main repo root after merge verification."}], "edges": [{"source": "_agents_skills_finishing_a_development_branch_skill_finishing_a_development_branch", "target": "_agents_skills_finishing_a_development_branch_skill_test_verification_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/finishing-a-development-branch/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_finishing_a_development_branch_skill_finishing_a_development_branch", "target": "_agents_skills_finishing_a_development_branch_skill_environment_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/finishing-a-development-branch/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_finishing_a_development_branch_skill_finishing_a_development_branch", "target": "_agents_skills_finishing_a_development_branch_skill_integration_options", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/finishing-a-development-branch/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_finishing_a_development_branch_skill_finishing_a_development_branch", "target": "_agents_skills_finishing_a_development_branch_skill_worktree_provenance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/finishing-a-development-branch/SKILL.md", "source_location": null, "wei