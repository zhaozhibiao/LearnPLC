{"nodes": [{"id": "_agents_skills_receiving_code_review_skill_receiving_code_review", "label": "receiving-code-review Skill", "file_type": "document", "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External feedback is treated as suggestions to evaluate rather than orders to follow; technical correctness outranks social comfort."}, {"id": "_agents_skills_receiving_code_review_skill_no_performative_agreement", "label": "No Performative Agreement", "file_type": "rationale", "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Praise and gratitude are forbidden because actions speak: the fix itself shows the feedback was heard, and agreement before verification is a documented violation."}, {"id": "_agents_skills_receiving_code_review_skill_verify_before_implementing", "label": "Verify Before Implementing", "file_type": "rationale", "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If any item is unclear, nothing is implemented until it is clarified, because items may be related and partial understanding produces a wrong implementation."}, {"id": "_agents_skills_receiving_code_review_skill_yagni_check", "label": "YAGNI Check for Professional Features", "file_type": "rationale", "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before building an endpoint 'properly', grep for actual usage; if unused, remove it instead, since both reviewer and implementer report to the same human partner."}, {"id": "_agents_skills_receiving_code_review_skill_pushback_protocol", "label": "Technical Pushback Protocol", "file_type": "rationale", "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Push back with technical reasoning when a suggestion breaks existing functionality, violates YAGNI, lacks context, or conflicts with prior architectural decisions; if later proven wrong, state the correction factually without apology."}], "edges": [{"source": "_agents_skills_receiving_code_review_skill_receiving_code_review", "target": "_agents_skills_receiving_code_review_skill_no_performative_agreement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_receiving_code_review_skill_receiving_code_review", "target": "_agents_skills_receiving_code_review_skill_verify_before_implementing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_receiving_code_review_skill_receiving_code_review", "target": "_agents_skills_receiving_code_review_skill_yagni_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_receiving_code_review_skill_receiving_code_review", "target": "_agents_skills_receiving_code_review_skill_pushback_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/receiving-code-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_receiving_code_review_skill_yagni_check", "target": "_agents_skills_receiving_code_review_skill_pushback_protocol", "