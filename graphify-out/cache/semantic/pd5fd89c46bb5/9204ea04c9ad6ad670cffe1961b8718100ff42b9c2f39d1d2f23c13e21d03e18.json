{"nodes": [{"id": "_agents_skills_subagent_driven_development_skill_subagent_driven_development", "label": "subagent-driven-development Skill", "file_type": "document", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh subagent per task plus two-stage review yields high quality with fast iteration in the same session, at the cost of more subagent invocations and upfront task extraction."}, {"id": "_agents_skills_subagent_driven_development_skill_two_stage_review", "label": "Two-Stage Review (Spec then Quality)", "file_type": "rationale", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec compliance is verified before code quality so the reviewer never polishes the wrong feature; review loops repeat until approved and self-review cannot replace either stage."}, {"id": "_agents_skills_subagent_driven_development_skill_fresh_subagent_per_task", "label": "Fresh Subagent per Task", "file_type": "rationale", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagents must never inherit session history; the controller curates full task text and context so workers stay focused and the controller's context stays free for coordination."}, {"id": "_agents_skills_subagent_driven_development_skill_implementer_status_handling", "label": "Implementer Status Handling (DONE/BLOCKED)", "file_type": "rationale", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of DONE, DONE_WITH_CONCERNS, NEEDS_CONTEXT and BLOCKED has a defined response; an escalation is never ignored and the same model is never retried unchanged, because if the implementer says it is stuck something must change."}, {"id": "_agents_skills_subagent_driven_development_skill_model_selection", "label": "Model Selection by Task Complexity", "file_type": "rationale", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the least powerful model that can handle the role: most well-specified tasks are mechanical, while architecture, design and review need the most capable model, conserving cost and increasing speed."}, {"id": "_agents_skills_subagent_driven_development_skill_continuous_execution", "label": "Continuous Execution Without Check-ins", "file_type": "rationale", "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pausing for 'should I continue?' wastes the human partner's time; only an unresolvable BLOCKED status, genuine ambiguity, or completion justifies stopping."}], "edges": [{"source": "_agents_skills_subagent_driven_development_skill_subagent_driven_development", "target": "_agents_skills_subagent_driven_development_skill_two_stage_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_subagent_driven_development_skill_subagent_driven_development", "target": "_agents_skills_subagent_driven_development_skill_fresh_subagent_per_task", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/subagent-driven-development/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_subagent_driven_development_skill_subag