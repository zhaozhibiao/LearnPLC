{"nodes": [{"id": "_agents_skills_dispatching_parallel_agents_skill_dispatching_parallel_agents", "label": "dispatching-parallel-agents Skill", "file_type": "document", "source_file": ".agents/skills/dispatching-parallel-agents/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegating to isolated-context agents keeps each worker narrow and preserves the coordinator's context for integration work."}, {"id": "_agents_skills_dispatching_parallel_agents_skill_independent_domain", "label": "One Agent per Independent Problem Domain", "file_type": "rationale", "source_file": ".agents/skills/dispatching-parallel-agents/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parallel dispatch is only safe when failures share no state and each can be understood without the others' context; related or shared-state failures must stay sequential."}, {"id": "_agents_skills_dispatching_parallel_agents_skill_agent_prompt_structure", "label": "Focused Self-Contained Agent Prompt", "file_type": "rationale", "source_file": ".agents/skills/dispatching-parallel-agents/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A prompt must be focused on one problem domain, self-contained with all needed context, and specific about the expected return value, otherwise agents get lost or refactor everything."}], "edges": [{"source": "_agents_skills_dispatching_parallel_agents_skill_dispatching_parallel_agents", "target": "_agents_skills_dispatching_parallel_agents_skill_independent_domain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/dispatching-parallel-agents/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_dispatching_parallel_agents_skill_dispatching_parallel_agents", "targ