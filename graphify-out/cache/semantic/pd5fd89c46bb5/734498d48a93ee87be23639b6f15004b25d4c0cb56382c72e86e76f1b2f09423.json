{"nodes": [{"id": "readme_st_workbench", "label": "ST Workbench", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-developed ST engineering workstation with an Avalonia desktop UI, targeting a standalone OpenPLC Runtime v4.3.0; only ST is implemented, ladder logic is intentionally deferred."}, {"id": "readme_openplc_runtime_v4_3_0", "label": "OpenPLC Runtime v4.3.0", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_avalonia_desktop_ui", "label": "Avalonia Desktop UI", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_st_language", "label": "Structured Text (ST)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_control_algorithms", "label": "15 Self-Developed Control Algorithms", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Library includes positional, incremental and cascade PID variants plus custom algorithm blocks, supplied as ST function blocks draggable from the resource palette."}, {"id": "readme_modbus_master", "label": "Linux Modbus TCP/RTU Master", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ecmotion_v4", "label": "EcMotion v4 Interface", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hardware_network_configuration", "label": "Hardware and Network Configuration", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately offline project configuration: pages stay synchronized and persist with the project, but nothing is downloaded to the bus or written to device networking yet."}, {"id": "readme_esi_catalog", "label": "ESI Catalog", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_st_online_monitoring", "label": "ST Online Monitoring", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values are sampled every 500 ms from authoritative debug mappings only; display markers never enter source, saved files or compilation, and dynamic array indices are deliberately not guessed."}, {"id": "readme_candidate_package", "label": "Candidate Package", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packages carry source identity, build artifacts, task configuration and debug symbols; identical project versions must produce byte-identical ZIPs so staged builds can be verified and reused, while tampered or differently-manifested sources are rejected."}, {"id": "readme_download_apply_workflow", "label": "Download and Application Workflow", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compile, download, activate and run are distinct states by design; indeterminate communication results require a manual refresh rather than automatic retry, and the prior run/stop state is restored and verified after applying."}, {"id": "readme_stproj_format", "label": ".stproj Project Format", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source files are stored as immutable versions so edits made during a save are never overwritten."}, {"id": "readme_mcp_server", "label": "Stdio MCP Service", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ssh_tunnel", "label": "Local-only SSH Tunnel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_strucpp_compiler", "label": "STruC++ 0.7.0 Compiler Adapter", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The GPL compiler is kept as a separate process behind an adapter and pinned to version 0.7.0 so the proprietary workstation avoids linking GPL code."}, {"id": "readme_verification_boundary", "label": "Verification and Boundary Rules", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Device verification must be recorded separately and cannot be substituted by local simulated tests; physical axis motion, real EtherCAT IO download and true EtherCAT scanning remain unverified."}, {"id": "readme_licensing_boundary", "label": "Commercial Licensing Boundary", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial distribution is a hard project constraint, so the boundary between the proprietary workstation and the independent GPL compile tool, third-party runtime exceptions and release TODOs are tracked; no licensing approval has been concluded for the final closed-source package."}, {"id": "readme_dxf_path_resources", "label": "DXF Path Resources", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_basic_axis_control", "label": "Basic Axis Control", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_continuous_path_backend", "label": "Continuous Path Virtual Backend", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Continuous execution is wired only to the standalone Linux virtual backend; motion candidate activation is refused when no matching backend is configured, because real EcMotion Continuous adaptation is not implemented."}], "edges": [{"source": "readme_st_workbench", "target": "readme_avalonia_desktop_ui", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_st_workbench", "target": "readme_openplc_runtime_v4_3_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_st_workbench", "target": "readme_st_language", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_st_workbench", "target": "readme_stproj_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_