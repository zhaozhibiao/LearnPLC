[Unit]
Description=ST Workbench native restricted hardware broker
Requires=stworkbench-hardware.socket
After=stworkbench-hardware.socket

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/stworkbench-hardware-broker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run /var/lib/st-workbench-ethercat
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LimitNOFILE=64
TasksMax=16
MemoryMax=256M
TimeoutStopSec=200

