[Unit]
Description=ST Workbench native basic axis bridge
PartOf=stworkbench-openplc.service

[Service]
Type=simple
ExecStart=/home/a/.local/share/st-workbench/is620n-axis/st-axis-worker --manifest /home/a/.local/share/st-workbench/is620n-axis/axis-manifest.json --socket /home/a/.local/share/st-workbench/is620n-axis/axis.sock --controller-socket /run/st-workbench-is620n/controller.sock --backend EcMotion
Restart=no
UMask=0077
NoNewPrivileges=yes
