@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+namespace ecmotion {
+
+struct SlaveIdentity {
+    unsigned int position{};
+    std::uint32_t vendor{};
+    std::uint32_t product{};
+    std::uint32_t revision{};
+    friend bool operator==(const SlaveIdentity&, const SlaveIdentity&) = default;
+};
+
+enum class SlaveIdentityStatus { Found, Unavailable, Mismatch };
+
+struct SlaveIdentityResult {
+    SlaveIdentityStatus status{};
+    std::size_t attempts{};
+    std::optional<SlaveIdentity> actual;
+};
+
+template <typename Lookup, typename Delay>
+SlaveIdentityResult wait_for_slave_identity(
+    const SlaveIdentity& expected, Lookup&& lookup, Delay&& delay,
+    std::size_t maximum_attempts) {
+    for (std::size_t attempt = 1; attempt <= maximum_attempts; ++attempt) {
+        const auto actual = lookup();
+        if (actual) {
+            return { *actual == expected ? SlaveIdentityStatus::Found : SlaveIdentityStatus::Mismatch,
+                attempt, actual };
+        }
+        if (attempt < maximum_attempts) delay();
+    }
+    return {SlaveIdentityStatus::Unavailable, maximum_attempts, std::nullopt};
+}
+
+} // namespace ecmotion
