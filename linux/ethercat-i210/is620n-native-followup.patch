+++ b/src/EcMotion.Igh/src/slave_identity_selftest.cpp
@@ -0,0 +1,47 @@
+#include "slave_identity.hpp"
+
+#include <stdexcept>
+#include <optional>
+#include <vector>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+}
+
+int main() {
+    using ecmotion::SlaveIdentity;
+    using ecmotion::SlaveIdentityStatus;
+    const SlaveIdentity expected{0, 0x00100000U, 0x000C0108U, 0x00010001U};
+    std::vector<std::optional<SlaveIdentity>> discovered{std::nullopt, std::nullopt, expected};
+    int delays = 0;
+    const auto ready = ecmotion::wait_for_slave_identity(
+        expected,
+        [&]() -> std::optional<SlaveIdentity> {
+            if (discovered.empty()) return std::nullopt;
+            const auto value = discovered.front();
+            discovered.erase(discovered.begin());
+            return value;
+        },
+        [&] { ++delays; }, 5);
+    require(ready.status == SlaveIdentityStatus::Found && delays == 2,
+        "startup must wait for a temporarily unavailable EtherCAT slave");
+
+    const auto absent = ecmotion::wait_for_slave_identity(
+        expected,
+        []() -> std::optional<SlaveIdentity> { return std::nullopt; },
+        [] {}, 3);
+    require(absent.status == SlaveIdentityStatus::Unavailable && absent.attempts == 3,
+        "startup must fail clearly when a slave stays absent");
+
+    const auto mismatch = ecmotion::wait_for_slave_identity(
+        expected,
+        []() -> std::optional<SlaveIdentity> {
+            return SlaveIdentity{0, 0x00100000U, 0x000C0108U, 0x00010002U};
+        },
+        [] { throw std::runtime_error("identity mismatch must not retry"); }, 5);
+    require(mismatch.status == SlaveIdentityStatus::Mismatch && mismatch.attempts == 1,
+        "a present but different drive must fail immediately");
+    return 0;
+}
